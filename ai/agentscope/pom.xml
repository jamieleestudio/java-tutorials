<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- 直接从仓库取 Boot 4，不走根 pom 的 Boot 3.3.3 -->
    </parent>

    <!-- AgentScope 教程的根聚合器。各叶子模块的 parent 指向这里，
         这样它们共用 Boot 4.0.3 + AgentScope BOM 2.0.3 的版本管理。 -->
    <groupId>com.third.li</groupId>
    <artifactId>agentscope</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>
    <name>agentscope</name>
    <description>AgentScope Java 教程：用 io.agentscope 2.0.3 + Spring Boot 4.0.3 演示 AgentScope 的核心能力与独有特性</description>

    <properties>
        <java.version>21</java.version>
        <agentscope.version>2.0.3</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AgentScope BOM：统一管理所有 io.agentscope:* 的版本 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>agentscope-basics</module>
        <module>agentscope-middleware</module>
        <module>agentscope-tools-skills</module>
        <module>agentscope-permission</module>
        <module>agentscope-workspace</module>
        <module>agentscope-memory-rag</module>
        <module>agentscope-service</module>
        <module>agentscope-capstone</module>
        <module>agentscope-patterns</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>